  <DataSources>
    <DataSource Name="StudentRegistrationDataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=DESKTOP-SNNU8IV\SQLEXPRESS;Initial Catalog=STUREG</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>2ae63be4-0091-4de7-b813-089f9fd48a27</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="StudentDetailsDataset">
      <Query>
        <DataSourceName>StudentRegistrationDataSource</DataSourceName>
        <CommandText>SELECT
    s.StudentID,
    s.FirstName,
    s.LastName,
    CONCAT(s.FirstName, ' ', s.LastName) AS FullName,
    s.Address,
    s.DateOfBirth,
    c.CourseName AS Course
FROM Students s 
INNER JOIN Courses c
    ON s.CourseID = c.CourseID
 WHERE s.IsDeleted = 0 
ORDER BY c.CourseName, s.FirstName;</CommandText>
      </Query>
      <Fields>
        <Field Name="StudentID">
          <DataField>StudentID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FirstName">
          <DataField>FirstName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastName">
          <DataField>LastName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FullName">
          <DataField>FullName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Address">
          <DataField>Address</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DateOfBirth">
          <DataField>DateOfBirth</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Course">
          <DataField>Course</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
